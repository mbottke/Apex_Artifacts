{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/optimized", "destination": "/deliverables/26-27_Call_Calendar_apex_v2_rebuild" },
    { "source": "/minimal", "destination": "/deliverables/26-27_Call_Calendar_apex_v1_repair" }
  ],
  "headers": [
    { "source": "/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=3600" }] },
    { "source": "/manifest.webmanifest", "headers": [{ "key": "Content-Type", "value": "application/manifest+json; charset=utf-8" }] },
    { "source": "/assets/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800, immutable" }] }
  ]
}
